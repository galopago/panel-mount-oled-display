    (class kicad_default "" /D1A /D1K /D2A /D2K /D3A /D3K /D4A /D4K /D5A /D5K
      /D6A /D6K /SCL /SDA /VCC GND "Net-(D1-K)" "Net-(D2-K)" "Net-(D3-K)"
      "Net-(D4-K)" "Net-(D5-K)" "Net-(D6-K)" "Net-(D7-A)" "Net-(DS1-C1N)"
      "Net-(DS1-C1P)" "Net-(DS1-C2N)" "Net-(DS1-C2P)" "Net-(DS1-D{slash}~{C})"
      "Net-(DS1-IREF)" "Net-(DS1-VBAT)" "Net-(DS1-VCC)" "Net-(DS1-VCOMH)"
      "unconnected-(DS1-NC-Pad7)"
      (circuit
        (use_via Via[0-1]_600:300_um)
      )
      (rule
        (width 200)
        (clearance 200.1)
      )
    )
  )
  (wiring
  )
)
